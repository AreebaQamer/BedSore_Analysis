pdate()\n","\n","        # If loss is NaN or infinity, stop training\n","        if is_training and (math.isnan(loss_item) or math.isinf(loss_item)):\n","            print(f\"Loss is NaN or infinite at epoch {epoch_id}, batch {batch_id}. Stopping training.\")\n","            break\n","\n","    # Cleanup and close the progress bar\n","    progress_bar.close()\n","\n","    return epoch_loss / (batch_id + 1)  # Return the average loss for this epoch\n","\n","\n","def train_model(model, train_dataloader, valid_dataloader, optimizer, lr_scheduler, num_epochs=10, device='cuda'):\n","    for epoch_id in range(num_epochs):\n","        start_time = time.time()\n","\n","        # Train the model for one epoch\n","        train_loss = run_epoch(model, train_dataloader, optimizer, lr_scheduler, device, scaler, epoch_id, is_training=True)\n","        print(f\"Epoch {epoch_id+1}/{num_epochs} - Train Loss: {train_loss:.4f}\")\n","\n","        # Evaluate the model on the validation set\n","        val_loss = run_epoch(model, valid_dataloader, optimizer, lr_scheduler, device, scaler, epoch_id, is_training=False)\n","        print(f\"Epoch {epoch_id+1}/{num_epochs} - Validation Loss: {val_loss:.4f}\")\n","\n","        # Print epoch duration\n","        epoch_duration = time.time() - start_time\n","        print(f\"Epoch {epoch_id+1} completed in {epoch_duration:.2f} seconds\")\n","\n","        # Save the model at the end of each epoch\n","        save_model(model, epoch_id)\n","\n","    return model\n","\n","def save_model(model, epoch_id, save_path=\"model_checkpoint.pth\"):\n","    \"\"\"Save the model's state_dict\"\"\"\n","    torch.save(model.state_dict(), f\"{save_path}_epoch_{epoch_id}.pth\")\n","    print(f\"Model saved at {save_path}_epoch_{epoch_id}.pth\")\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ko8mJklG9fQw","colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1PiQF5HaEracQZ4E8CD2oL7pmk9ee4-NK"},"outputId"