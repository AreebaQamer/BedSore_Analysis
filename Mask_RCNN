nts()\n","\n","# Plot the distribution\n","import matplotlib.pyplot as plt\n","\n","plt.figure(figsize=(10, 6))\n","class_counts.plot(kind='bar')\n","plt.title('Class Distribution')\n","plt.ylabel('Count')\n","plt.xlabel('Classes')\n","plt.xticks(rotation=75)  # Rotate x-axis labels for better readability\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"lE3vInUzucr-"},"source":["**Creating Custom classes for Masks**"]},{"cell_type":"code","execution_count":8,"metadata":{"executionInfo":{"elapsed":370,"status":"ok","timestamp":1734669442880,"user":{"displayName":"Areeba","userId":"15200168925543717833"},"user_tz":-300},"id":"-Ih2qhfKudNq"},"outputs":[],"source":["import json\n","import os\n","import numpy as np\n","import torch\n","from torch.utils.data import Dataset\n","from PIL import Image, ImageDraw\n","import torchvision.transforms as transforms\n","\n","# Custom class for handling Masks\n","class Mask:\n","    def __init__(self, mask_data):\n","        if isinstance(mask_data, list):\n","            self.data = [torch.tensor(m, dtype=torch.bool).clone().detach() for m in mask_data]\n","        else:\n","            self.data = torch.tensor(mask_data, dtype=torch.bool)\n","\n","    def __repr__(self):\n","        return f\"Mask({self.data})\"\n","\n","# Custom Dataset class\n","class CustomDataset(Dataset):\n","    def __init__(self, coco_file, img_dir, transform=None):\n","        with open(coco_file, 'r') as f:\n","            self.coco_data = json.load(f)\n","\n","        self.img_dir = img_dir\n","        self.transform = transform\n","        self._create_image_mapping()\n","\n","    def _create_image_mapping(self):\n","        self.img_dict = {}\n","        for img_info in self.coco_data['images']:\n","            image_id = img_info['id']\n","            image_name = img_info['file_name']\n","            image_path = os.path.join(self.img_dir, image_name)\n","\n","            if os.path.exists(image_path):\n","                self.img_dict[image_id] = {\n","                    'image_path': image_path,\n","                    'image_name': image_name,\n","                    'image_id': image_id\n","                }\n","            else:\n","                print(f\"Warning: Image {image_name} not found in {self.img_dir}\")\n","\n","    def __len__(self):\n","        return len(self.img_dict)\n","\n","    def __getitem__(self, idx):\n","        image_data = list(self.img_dict.values())[idx]\n","        image_id = image_data['image_id']\n","        image_path = image_data['image_path']\n","        image = self._load_image(image_path)\n","\n","        annotations = self._get_image_annotations(image_id)\n","        bboxes = []\n","        labels = []\n","        masks = []\n","\n","        for annotation in annotations:\n","            bbox = annotation['bbox']\n","            label = annotation['category_id']\n","            segmentation = annotation['segmentation']\n","\n","            corrected_bbox = self.validate_and_correct_bbox(bbox)\n","            if corrected_bbox:  # Check if bbox is valid\n","                bboxes.append(corrected_bbox)\n","                mask = self._create_mask(image.size, segmentation)\n","                if mask.sum() > 0:  # Check if the mask has any True values\n","                    masks.append(mask)\n","\n","            labels.append(label)\n","\n","        if self.transform:\n","            image = self.transform(image)\n","\n","        # Print sizes for debugging\n","        print(f\"Image size: {image.size()}\")  # Use the correct method to get size of the tensor\n","        masks_tensor = torch.stack(masks) if masks else torch.empty((0, 512, 512), dtype=torch.bool)  # Handle empty masks case\n","        print(f\"Masks tensor size: {masks_tensor.size()}\")  # Size of the masks tensor\n","        bboxes_tensor = torch.tensor(bboxes, dtype=torch.float32) if bboxes else torch.empty((0, 4), dtype=torch.float32)\n","\n","        target_dict = {\n","            'masks': masks_tensor,\n","            'boxes': bboxes_tensor,\n","            'labels': torch.tensor(labels, dtype=torch.int64)\n","        }\n","\n","        return image, target_dict\n","\n","    def validate_and_correct_bbox(self, bbox):\n","        x_min, y_min, width, height = bbox\n","        x_max = x_min + width\n","        y_max = y_min + height\n","\n","        if width <= 0 or height <= 0:\n","            width = 1\n","            height = 1\n","            x_max = x_min + width\n","            y_max = y_min + height\n","\n","        return [x_min, y_min, x_max, y_max]\n","\n","    def _load_image(self, image_path):\n","        return Image.open(image_path).convert(\"RGB\")\n","\n","    def _get_image_annotations(self, image_id):\n","        return [ann for ann in self.coco_data['annotations'] if ann['image_id'] == image_id]\n","\n","    def _create_mask(self, image_size, segmentation):\n","        # Initialize the mask to zeros with the correct size\n","        mask = Image.new('L', image_size, 0)  # Create a black mask\n","        if isinstance(segmentation, list):\n","            for polygon in segmentation:\n","                ImageDraw.Draw(mask).polygon(polygon, outline=1, fill=1)  # Draw polygon on mask\n","\n","        # Convert mask to tensor\n","        mask = torch.tensor(np.array(mask), dtype=torch.bool)\n","\n","        # Resize to match the expected size (512x512)\n","        if self.transform:\n","            mask = transforms.Resize((512, 512))(mask.unsqueeze(0)).squeeze(0)  # Resize mask to match image size\n","\n","        return mask"]},{"cell_type":"markdown","metadata":{"id":"fL2c6SyxueCR"},"source":["**Initialize DataSet**"]},{"cell_type":"code","execution_count":9,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1424,"status":"ok","timestamp":1734669449611,"user":{"displayName":"Areeba","userId":"15200168925543717833"},"user_tz":-300},"id":"DrLoXtK1uerq","outputId":"c7617375-7972-4d8b-9237-b1b46ea5a553"},"outputs":[{"output_type":"stream","name":"stdout","text":["Image size: torch.Size([3, 512, 512])\n","Masks tensor size: torch.Size([1, 512, 512])\n","Image Path: /content/drive/MyDrive/FYP Application 2/Dataset/train/images/puds6_jpg.rf.1d480e4034beca6b13e7cc521b0ac904.jpg\n","Target (Annotations): {'masks': tensor([[[False, False, False,  ..., False, False, False],\n","         [False, False, False,  ..., False, False, False],\n","         [False, False, False,  ..., False, False, False],\n","         ...,\n","         [False, False, False,  ..., False, False, False],\n","         [False, False, False,  ..., False, False, False],\n","         [False, False, False,  ..., False, False, False]]]), 'boxes': tensor([[ 87.0000,  71.0000, 196.0850, 154.0190]]), 'labels': tensor([3])}\n"]}],"source":["# Sample code for using the CustomDataset\n","train_coco_file = '/content/drive/MyDrive/FYP Application 2/Dataset/train/annotations/_annotations.coco.json'\n","train_img_dir = '/content/drive/MyDrive/FYP Application 2/Dataset/train/images'\n","val_coco_file = '/content/drive/MyDrive/FYP Application 2/Dataset/val/annotations/_annotations.coco.json'  # Ensure this path is correct\n","val_img_dir = '/content/drive/MyDrive/FYP Application 2/Dataset/val/images'\n","\n","# Define a transform to resize images\n","transform = transforms.Compose([\n","    transforms.Resize((512, 512)),  # Specify your desired size (height, width)\n","    transforms.ToTensor(),\n","])\n","\n","# Create a dataset with main transforms\n","train_dataset = CustomDataset(coco_file=train_coco_file, img_dir=train_img_dir, transform=transform)\n","val_dataset = CustomDataset(coco_file=val_coco_file, img_dir=val_img_dir, transform=transform)\n","\n","# Access an example (image, target)\n","example_index = 5\n","image, target = train_dataset[example_index]\n","\n","# Print the image path and its annotations\n","image_id = list(train_dataset.img_dict.keys())[example_index]  # Get the image ID using the index\n","image_path = train_dataset.img_dict[image_id]['image_path']  # Access the image path from img_dict\n","print(f\"Image Path: {image_path}\")  # Print the image path\n","print(\"Target (Annotations):\", target)  # Print the annotations"]},{"cell_type":"markdown","metadata":{"id":"VGTBecuKu3Ub"},"source":["**Custom Collate funtion**"]},{"cell_type":"code","execution_count":10,"metadata":{"executionInfo":{"elapsed":345,"status":"ok","timestamp":1734669454304,"user":{"displayName":"Areeba","userId":"15200168925543717833"},"user_tz":-300},"id":"KLZ7ecqMu3r2"},"outputs":[],"source":["\n","def collate_fn(batch):\n","    images, targets = zip(*batch)\n","\n","    # Convert images to tensors (and normalize)\n","    images = [torch.tensor(np.array(img) / 255.0, dtype=torch.float32).permute(2, 0, 1) for img in images]\n","    images = torch.stack(images, dim=0)\n","\n","    targets = []\n","    for t in targets:\n","        target_dict = {\n","            'masks': t['masks'].to('cuda' if torch.cuda.is_available() else 'cpu'),  # Move to device\n","            'boxes': torch.tensor(t['boxes'], dtype=torch.float32).to('cuda' if torch.cuda.is_available() else 'cpu') if len(t['boxes']) > 0 else torch.empty((0, 4), dtype=torch.float32),\n","            'labels': torch.tensor(t['labels'], dtype=torch.int64).to('cuda' if torch.cuda.is_available() else 'cpu')\n","        }\n","        targets.append(target_dict)\n","\n","    return {'images': images, 'targets': targets}\n"]},{"cell_type":"markdown","metadata":{"id":"ZH-KZRtMu4Jt"},"source":["**Initialize DataLoader**"]},{"cell_type":"code","execution_count":11,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":886,"status":"ok","timestamp":1734669464224,"user":{"displayName":"Areeba","userId":"15200168925543717833"},"user_tz":-300},"id":"mRNE_j-Qu4gL","outputId":"ec74a9d8-11f1-4f2e-9d38-672b9a93f9f4"},"outputs":[{"output_type":"stream","name":"stdout","text":["<pandas.io.formats.style.Styler object at 0x7c1a433ef040>\n"]}],"source":["import multiprocessing\n","from torch.utils.data import DataLoader\n","import torch\n","import pandas as pd\n","\n","bs = 4\n","num_workers = multiprocessing.cpu_count() // 2\n","\n","data_loader_params = {\n","    'batch_size': bs,\n","    'num_workers': num_workers,\n","    'persistent_workers': True,\n","    'pin_memory': torch.cuda.is_available(),\n","    'collate_fn': collate_fn,\n","}\n","\n","# Create DataLoader for training and validation data\n","train_dataloader = DataLoader(train_dataset, **data_loader_params, shuffle=True)\n","valid_dataloader = DataLoader(val_dataset, **data_loader_params, shuffle=False)\n","\n","# Print the number of batches in the training and validation DataLoaders\n","batch_counts = {\n","    'Number of batches in train DataLoader:': len(train_dataloader),\n","    'Number of batches in validation DataLoader:': len(valid_dataloader)\n","}\n","\n","# Display the number of batches\n","batch_counts_df = pd.Series(batch_counts).to_frame()\n","print(batch_counts_df.style.hide(axis='columns'))"]},{"cell_type":"markdown","metadata":{"id":"ZKhoWVtVu4z_"},"source":[]},{"cell_type":"code","execution_count":12,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"EydG4wplu5YL","executionInfo":{"status":"ok","timestamp":1734669470566,"user_tz":-300,"elapsed":4655,"user":{"displayName":"Areeba","userId":"15200168925543717833"}},"outputId":"844e0390-2366-479a-cbc3-ea1c22875549"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import json\n","import os\n","import random\n","from PIL import Image, ImageDraw, ImageFont\n","import matplotlib.pyplot as plt\n","\n","# Load COCO annotations from a JSON file\n","def load_coco_annotations(annotation_file):\n","    with open(annotation_file, 'r') as f:\n","        annotations = json.load(f)\n","    return annotations\n","\n","# Define a color mapping based on category IDs\n","int_colors = {\n","    0: (150, 100, 90),   # Background (Darkened)\n","    1: (100, 60, 45),    # Skin (Darker skin)\n","    2: (200, 0, 0),      # Stage 0 (Darkened Bright Red)\n","    3: (0, 200, 0),      # Stage 1 (Darkened Bright Green)\n","    4: (0, 0, 200),      # Stage 2 (Darkened Bright Blue)\n","    5: (153, 99, 0),     # Stage 3 (Dark Orange)\n","    6: (100, 0, 100),    # Stage 4 (Darker Purple)\n","    7: (200, 200, 0),     # Surrounding (Darker Yellow)\n","}\n","\n","# Load category names from the annotations\n","def load_category_names(annotations):\n","    category_names = {}\n","    for category in annotations['categories']:\n","        category_names[category['id']] = category['name']\n","    return category_names\n","\n","# Draw bounding boxes and class names on the image with category-based colors\n","def draw_bounding_boxes(image, boxes, category_names):\n","    draw = ImageDraw.Draw(image)\n","    # Set font size and load font\n","    try:\n","      font = ImageFont.truetype(\"DejaVuSans-Bold.ttf\", size=14)  # Increased font size for better clarity\n","    except IOError:\n","        font = ImageFont.load_default()  # Fallback to default if the specified font isn't found\n","\n","    for box in boxes:\n","        # Box format: [xmin, ymin, width, height, category_id]\n","        x_min, y_min, width, height, category_id = box\n","\n","        # Reduce the size of the bounding box further\n","        padding = 10 # Increase padding to make the bounding box smaller\n","        x_min += padding\n","        y_min += padding\n","        width -= padding * 2\n","        height -= padding * 2\n","\n","        # Ensure the bounding box dimensions are not negative\n","        width = max(1, width)\n","        height = max(1, height)\n","\n","        color = int_colors.get(category_id, (255, 0, 0))  # Default to red if category not found\n","        draw.rectangle([x_min, y_min, x_min + width, y_min + height], outline=color, width=2)\n","\n","        # Get the category name\n","        category_name = category_names.get(category_id, \"Unknown\")\n","\n","        # Draw the category name above the bounding box\n","        draw.text((x_min, y_min - 25), category_name, fill=color, font=font)\n","\n","    return image\n","# Main function to process images and annotations\n","def process_annotations_and_draw_boxes(annotations_file, images_dir):\n","    # Load annotations\n","    annotations = load_coco_annotations(annotations_file)\n","\n","    # Load category names\n","    category_names = load_category_names(annotations)\n","\n","    # Select 3 random images from the annotations\n","    random_images = random.sample(annotations['images'], 3)\n","\n","    # Iterate through selected random images\n","    for image_info in random_images:\n","        image_id = image_info['id']\n","        image_file_name = image_info['file_name']\n","        image_path = os.path.join(images_dir, image_file_name)\n","\n","        # Load image\n","        image = Image.open(image_path).convert('RGB')\n","\n","        # Find bounding boxes for the current image\n","        boxes = []\n","        for annotation in annotations['annotations']:\n","            if annotation['image_id'] == image_id:\n","                bbox = annotation['bbox']  # [xmin, ymin, width, height]\n","                category_id = annotation['category_id']\n","                boxes.append((*bbox, category_id))  # Append bbox with category_id\n","        # Draw bounding boxes and class names on the image\n","        annotated_image = draw_bounding_boxes(image, boxes, category_names)\n","        # Display the image\n","        plt.figure(figsize=(8, 8))\n","        plt.imshow(annotated_image)\n","        plt.axis('off')\n","        plt.title(f\"Image ID: {image_id}\")\n","        plt.show()\n","\n","# Specify paths\n","annotations_file = '/content/drive/MyDrive/FYP Application 2/Dataset/train/annotations/_annotations.coco.json'\n","images_dir = '/content/drive/MyDrive/FYP Application 2/Dataset/train/images'\n","\n","# Call the main function\n","process_annotations_and_draw_boxes(annotations_file, images_dir)"]},{"cell_type":"markdown","metadata":{"id":"7Q0S5WLmvKQY"},"source":["**Training Loop**"]},{"cell_type":"code","execution_count":13,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2788,"status":"ok","timestamp":1734669490583,"user":{"displayName":"Areeba","userId":"15200168925543717833"},"user_tz":-300},"id":"B2gcC8_8vK62","outputId":"ea846200-5f9d-429e-e8ab-86f3ff0277f7"},"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.10/dist-packages/torchvision/models/_utils.py:208: UserWarning: The parameter 'pretrained' is deprecated since 0.13 and may be removed in the future, please use 'weights' instead.\n","  warnings.warn(\n","/usr/local/lib/python3.10/dist-packages/torchvision/models/_utils.py:223: UserWarning: Arguments other than a weight enum or `None` for 'weights' are deprecated since 0.13 and may be removed in the future. The current behavior is equivalent to passing `weights=MaskRCNN_ResNet50_FPN_Weights.COCO_V1`. You can also use `weights=MaskRCNN_ResNet50_FPN_Weights.DEFAULT` to get the most up-to-date weights.\n","  warnings.warn(msg)\n","Downloading: \"https://download.pytorch.org/models/maskrcnn_resnet50_fpn_coco-bf2d0c1e.pth\" to /root/.cache/torch/hub/checkpoints/maskrcnn_resnet50_fpn_coco-bf2d0c1e.pth\n","100%|██████████| 170M/170M [00:01<00:00, 166MB/s]\n"]},{"output_type":"stream","name":"stdout","text":["Pre-trained Model Summary:\n","MaskRCNN(\n","  (transform): GeneralizedRCNNTransform(\n","      Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n","      Re