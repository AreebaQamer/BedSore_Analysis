# Base image
FROM node:18

# Install Python, pip, venv, and libGL
RUN apt-get update && \
    apt-get install -y python3 python3-pip python3-venv libgl1 && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Node.js dependency files first and install
COPY package*.json ./
RUN npm install

# Copy only requirements.txt and install Python packages (to allow Docker caching)
COPY requirements.txt ./

# Create virtual environment and install Python packages
RUN python3 -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir --prefer-binary -r requirements.txt

# Add venv to PATH
ENV PATH="/opt/venv/bin:$PATH"

# Copy the rest of the project files
COPY . .

# Expose backend port
EXPOSE 5000

# Start the app
CMD ["node", "index.js"]
